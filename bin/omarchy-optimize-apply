#!/bin/bash
# omarchy-optimize-apply — execute the recommendations the user marked.
#
# Args:
#   apply <json-array-of-ids>   Run each selected recommendation by id.
#
# Action handling:
#   - "command"   : run the command verbatim. If it needs privileges, hand it
#                  to a floating terminal so the password prompt is visible.
#   - "uninstall" : pacman -Rns (needs sudo → floating terminal).
#   - "delete"    : rm -rf the path under $HOME (no sudo for home files).
#   - "cloud"     : hand off to the configured cloud handler (rclone,
#                  local-send, tailscale) — see OMARCHY_OPTIMIZE_CLOUD.
#   - "archive"   : tar the path into ~/Archive and remove the original.
#
# Writes a JSON object {id: "ok"|"failed"|"skipped"} to stdout.

set -euo pipefail

STATE_DIR="${OMARCHY_OPTIMIZE_STATE_DIR:-$HOME/.local/state/omarchy/optimize}"
RECS="$STATE_DIR/recommendations.json"
CLOUD="${OMARCHY_OPTIMIZE_CLOUD:-none}"
FLOATING_TERMINAL="omarchy-launch-floating-terminal-with-presentation"

usage() { echo "Usage: $0 apply <json-array-of-ids>"; }

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then usage; exit 0; fi
[[ ${1:-} == "apply" ]] || { usage >&2; exit 2; }
shift
[[ $# -ge 1 ]] || { usage >&2; exit 2; }

IDS_JSON="$1"
[[ -f "$RECS" ]] || { echo "no recommendations.json" >&2; exit 1; }

RESULT=$(python3 - "$IDS_JSON" "$RECS" <<'PY'
import json, sys, os
ids = json.loads(sys.argv[1])
recs = json.load(open(sys.argv[2]))
by_id = {r["id"]: r for r in recs}
selected = [by_id[i] for i in ids if i in by_id]
# Print one JSON object per line so bash can read them safely.
for r in selected:
    print(json.dumps({
        "id": r["id"],
        "action": r.get("action","command"),
        "path": r.get("path",""),
        "command": r.get("command",""),
    }))
PY
)

run_sudo_in_terminal() {
  local cmd="$1"
  if command -v "$FLOATING_TERMINAL" >/dev/null 2>&1; then
    $FLOATING_TERMINAL "$cmd; omarchy show done" 2>/dev/null
    return $?
  else
    pkexec bash -c "$cmd" 2>/dev/null
    return $?
  fi
}

declare -A STATUS

# Verify that packages are actually uninstalled. Sets STATUS[$id] based on
# how many packages still appear installed.
verify_uninstall() {
  local pkgs="$1"
  local still_installed=0
  local total=0
  for pkg in $pkgs; do
    total=$((total + 1))
    if pacman -Qi "$pkg" >/dev/null 2>&1; then
      still_installed=$((still_installed + 1))
    fi
  done
  if [[ $still_installed -eq 0 ]]; then
    : # keep STATUS=ok
  elif [[ $still_installed -eq $total ]]; then
    STATUS[$id]="failed"
  else
    STATUS[$id]="partial"
  fi
}

while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  # Parse the JSON line safely (avoids tab-splitting issues with empty fields).
  id=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$line")
  action=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["action"])' <<<"$line")
  path=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["path"])' <<<"$line")
  command=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["command"])' <<<"$line")
  verify=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("verify",""))' <<<"$line")
  STATUS[$id]="ok"
  case "$action" in
    command)
      [[ -n "$command" ]] || { STATUS[$id]="skipped"; continue; }
      if grep -qE "sudo|pkexec|pacman|systemctl|rm -rf /" <<<"$command"; then
        run_sudo_in_terminal "$command"
        ec=$?
        if [[ $ec -ne 0 ]]; then STATUS[$id]="failed"; else STATUS[$id]="ok"; fi
      else
        set +e
        bash -c "$command" >/dev/null 2>&1
        ec=$?
        set -e
        if [[ $ec -eq 0 ]]; then STATUS[$id]="ok"
        else STATUS[$id]="partial"; fi
      fi
      ;;
    uninstall)
      pkgs="${command:-$path}"
      [[ -n "$pkgs" ]] || { STATUS[$id]="skipped"; continue; }
      run_sudo_in_terminal "sudo pacman -Rns --noconfirm $pkgs"
      ec=$?
      if [[ $ec -ne 0 ]]; then
        STATUS[$id]="failed"
      else
        verify_uninstall "$pkgs"
      fi
      ;;
    delete)
      target="${command:-$path}"
      [[ -n "$target" ]] || { STATUS[$id]="skipped"; continue; }
      target="${target/#\~/$HOME}"
      if [[ "$target" == "$HOME" || "$target" == "/" ]]; then
        STATUS[$id]="skipped"; continue
      fi
      set +e
      rm -rf -- "$target" >/dev/null 2>&1
      set -e
      if [[ ! -e "$target" ]]; then STATUS[$id]="ok"
      else STATUS[$id]="failed"; fi
      ;;
    archive)
      target="${command:-$path}"
      [[ -n "$target" ]] || { STATUS[$id]="skipped"; continue; }
      target="${target/#\~/$HOME}"
      archive_dir="$HOME/Archive"
      mkdir -p "$archive_dir"
      name="$(basename "$target")"
      archive_path="$archive_dir/${name}.tar.gz"
      set +e
      tar -czf "$archive_path" -C "$(dirname "$target")" "$name" >/dev/null 2>&1
      set -e
      if [[ -f "$archive_path" ]] && [[ ! -e "$target" ]]; then
        STATUS[$id]="ok"
      elif [[ -f "$archive_path" ]]; then
        STATUS[$id]="partial"
      else
        STATUS[$id]="failed"
      fi
      ;;
    cloud)
      target="${command:-$path}"
      [[ -n "$target" ]] || { STATUS[$id]="skipped"; continue; }
      target="${target/#\~/$HOME}"
      case "$CLOUD" in
        rclone)
          command -v rclone >/dev/null 2>&1 || { STATUS[$id]="skipped"; continue; }
          set +e
          rclone copy "$target" "omarchy-optimize:$(basename "$target")" >/dev/null 2>&1
          ec=$?
          set -e
          if [[ $ec -eq 0 ]]; then STATUS[$id]="ok"; else STATUS[$id]="failed"; fi
          ;;
        local-send)
          set +e
          omarchy share file "$target" >/dev/null 2>&1
          ec=$?
          set -e
          if [[ $ec -eq 0 ]]; then STATUS[$id]="ok"; else STATUS[$id]="failed"; fi
          ;;
        tailscale)
          set +e
          omarchy tailscale send "$target" >/dev/null 2>&1
          ec=$?
          set -e
          if [[ $ec -eq 0 ]]; then STATUS[$id]="ok"; else STATUS[$id]="failed"; fi
          ;;
        *)
          STATUS[$id]="skipped"
          ;;
      esac
      ;;
    suggest|*)
      STATUS[$id]="skipped"
      ;;
  esac

  # If the agent provided a verify command, run it to confirm the action
  # actually took effect. This overrides the built-in verification.
  if [[ -n "$verify" && "${STATUS[$id]}" != "skipped" ]]; then
    set +e
    bash -c "$verify" >/dev/null 2>&1
    local vec=$?
    set -e
    if [[ $vec -eq 0 ]]; then
      STATUS[$id]="ok"
    else
      [[ "${STATUS[$id]}" == "ok" ]] && STATUS[$id]="failed"
    fi
  fi
done <<<"$RESULT"

# Emit JSON result: {id: "ok"|"failed"|"skipped"}.
{
  echo -n '{'
  first=1
  for id in "${!STATUS[@]}"; do
    [[ $first -eq 0 ]] && echo -n ','
    printf '"%s":"%s"' "$id" "${STATUS[$id]}"
    first=0
  done
  echo -n '}'
} | python3 -m json.tool
