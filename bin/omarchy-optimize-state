#!/bin/bash
# omarchy-optimize-state — read/write the optimizer's state files.
#
# Subcommands:
#   read            Print state.json as-is (or {} if missing).
#   recommendations Print recommendations.json as an array (or []).
#   dismiss <id>    Remove a recommendation by id and update state.
#   reset           Clear state to {status:"idle"} (keeps snapshot).
#   write <status> <count>
#                   Manually set status + pending_count (used by the timer).

set -euo pipefail

STATE_DIR="${OMARCHY_OPTIMIZE_STATE_DIR:-$HOME/.local/state/omarchy/optimize}"
mkdir -p "$STATE_DIR"
STATE="$STATE_DIR/state.json"
RECS="$STATE_DIR/recommendations.json"
DISMISSED="$STATE_DIR/dismissed.json"

ensure_dismissed() {
  [[ -f "$DISMISSED" ]] || echo '[]' > "$DISMISSED"
}

cmd="${1:-read}"
[[ -z "${2:-}" || "$2" == "" ]] && shift || true
[[ $# -ge 1 ]] && shift || true

case "$cmd" in
  read)
    if [[ -f "$STATE" ]]; then cat "$STATE"; else echo '{}'; fi
    ;;
  recommendations)
    if [[ -f "$RECS" ]]; then cat "$RECS"; else echo '[]'; fi
    ;;
  dismiss)
    id="${1:-}"
    [[ -n "$id" ]] || { echo "dismiss needs an id" >&2; exit 2; }
    ensure_dismissed
    if [[ -f "$RECS" ]]; then
      python3 - "$RECS" "$id" "$STATE" "$DISMISSED" <<'PY'
import json, sys, os, datetime
recs_path, drop_id, state_path, dismissed_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
# Remove from current recommendations.
recs = json.load(open(recs_path))
recs = [r for r in recs if r.get("id") != drop_id]
json.dump(recs, open(recs_path, "w"), indent=2)
# Add to persistent blocklist (dedupe by id).
try: dismissed = json.load(open(dismissed_path))
except: dismissed = []
if not any(d.get("id") == drop_id for d in dismissed):
  dismissed.append({"id": drop_id, "dismissed_at": datetime.datetime.now(datetime.timezone.utc).isoformat()})
json.dump(dismissed, open(dismissed_path, "w"), indent=2)
# Update state.
state = {}
if os.path.exists(state_path):
    try: state = json.load(open(state_path))
    except: pass
state["pending_count"] = len(recs)
state["status"] = "optimized" if len(recs) == 0 else state.get("status", "pending")
state["last_scan"] = state.get("last_scan") or datetime.datetime.now(datetime.timezone.utc).isoformat()
json.dump(state, open(state_path, "w"), indent=2)
PY
    fi
    echo "dismissed $id (won't be recommended again)"
    ;;
  list-dismissed)
    ensure_dismissed
    cat "$DISMISSED"
    ;;
  restore)
    id="${1:-}"
    [[ -n "$id" ]] || { echo "restore needs an id" >&2; exit 2; }
    ensure_dismissed
    python3 - "$DISMISSED" "$id" <<'PY'
import json, sys
path, rid = sys.argv[1], sys.argv[2]
try: dismissed = json.load(open(path))
except: dismissed = []
dismissed = [d for d in dismissed if d.get("id") != rid]
json.dump(dismissed, open(path, "w"), indent=2)
PY
    echo "restored $id (will be recommended again on next scan)"
    ;;
  reset)
    echo '{"status":"idle","pending_count":0,"last_scan":""}' > "$STATE"
    echo "reset"
    ;;
  write)
    status="${1:-idle}"
    count="${2:-0}"
    python3 - "$STATE" "$status" "$count" <<'PY'
import json, sys, os, datetime
path, status, count = sys.argv[1], sys.argv[2], int(sys.argv[3])
state = {}
if os.path.exists(path):
    try: state = json.load(open(path))
    except: pass
state["status"] = status
state["pending_count"] = count
state["last_scan"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
json.dump(state, open(path, "w"), indent=2)
PY
    ;;
  -h|--help|help)
    echo "Usage: omarchy-optimize-state <read|recommendations|dismiss <id>|list-dismissed|restore <id>|reset|write <status> <count>>"
    ;;
  *)
    echo "unknown subcommand: $cmd" >&2
    exit 2
    ;;
esac
