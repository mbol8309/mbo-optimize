[Unit]
Description=Omarchy Optimize — weekly scan trigger
Documentation=https://github.com/mbol8309/mbo-optimize

[Timer]
# Default: weekly, Monday 09:00. Override the interval in the panel settings
# (scanIntervalDays) — deploy.sh regenerates the OnCalendar from that value.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
Unit=mbo-optimize-scan.service

[Install]
WantedBy=timers.target
